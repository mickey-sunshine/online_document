create_arch 
set_core_dimension --height 12 --width 12
set_num_clock --num 4
set_num_reset --num 2
set_num_prog_clock --num 32
set_num_config_region --num 16
set_io_num --side top --type input --num 144 # 144=12*12
set_io_num --side top --type output --num 108 # 108=12*9
set_io_num --side bottom --type input --num 144 # 144=12*12
set_io_num --side bottom --type output --num 108 # 108=12*9
set_io_num --side left --type input --num 144 # 144=12*12
set_io_num --side left --type output --num 96 # 96=12*8
set_io_num --side right --type input --num 144 # 144=12*12
set_io_num --side right --type output --num 108 # 108=12*9
analyze_logic_resource --min_lut_size 5 --max_lut_size 5 --report_qor ./save/report/qor_prearch.csv --verbosity 1
setup_arch
save_tapeout --config_file ./save/project/s1_setup.xml
set_arch --type module_names --file ./config/module_names1.xml
set_arch --type crafted_fabric_key --file ./config/custom_fabric_key.xml
# set_arch --type module_names
# set_arch --type crafted_fabric_key
set_arch --fabric dp --type io_pin_table_naming_rules 
set_arch --fabric ultimate --type io_pin_table_naming_rules 
eval_arch --report_qor ./save/report/rpt0_eval_arch.csv --verbosity 1
save_tapeout --config_file ./save/project/s2_eval.xml
analyze_qor --file ./save/report/rpt1_analyze_qor.csv --verbosity 1
generate_netlist --netlist_makeup
save_tapeout --config_file ./save/project/s3_rtl.xml
optimize_netlist --jobs 64 --dryrun
save_tapeout --config_file ./save/project/s4_gl.xml
setup_design_verification --jobs 64
save_tapeout --config_file ./save/project/s5_setup_dv.xml
run_preconfigured_simulation --jobs 64 --dump_waveform fsdb --netlist_type rtl
optimize_netlist --jobs 64
run_preconfigured_simulation --jobs 64 --dump_waveform fsdb --netlist_type gl
